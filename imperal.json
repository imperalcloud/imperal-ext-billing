      "action_type": "read",
      "chain_callable": false,
      "effects": [],
      "params_schema": {
        "description": "Parameters for CSV export.",
        "properties": {
          "period": {
            "default": "all",
            "description": "Time period: today, 7d, 30d, all",
            "title": "Period",
            "type": "string"
          },
          "app_id": {
            "default": "",
            "description": "Filter by extension (optional)",
            "title": "App Id",
            "type": "string"
          },
          "tx_type": {
            "default": "",
            "description": "Filter by type: deduct, credit (optional)",
            "title": "Tx Type",
            "type": "string"
          }
