{
  "manifest_schema_version": 3,
  "app_id": "billing",
  "version": "2.1.1",
  "name": "Billing",
  "description": "Billing dashboard — check token balance, review spending history, manage subscription plan, view payment transactions, export usage reports for accounting.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "capabilities": [
    "billing:read"
  ],
  "tools": [
    {
      "name": "tool_billing_chat",
      "description": "Billing assistant — check token balance, view spending history, subscription plans, and export transactions. All actions cost 0 tokens.",
      "scopes": [],
      "parameters": {
        "message": {
          "type": "string",
          "required": false
        },
        "kwargs": {
          "type": "string",
          "required": true
        }
      },
      "synthetic": false
    },
    {
      "name": "skeleton_refresh_billing_status",
      "description": "Background refresh: billing status for AI context.",
      "scopes": [],
      "parameters": {
        "kwargs": {
          "type": "string",
          "required": true
        }
      },
      "synthetic": false
    },
    {
      "name": "__panel__sidebar",
      "description": "Panel: Billing",
      "scopes": [],
      "parameters": {
        "params": {
          "type": "string",
          "required": true
        }
      },
      "synthetic": true
    },
    {
      "name": "__panel__dashboard",
      "description": "Panel: Analytics",
      "scopes": [],
      "parameters": {
        "params": {
          "type": "string",
          "required": true
        }
      },
      "synthetic": true
    },
    {
      "name": "get_balance",
      "description": "Get current token balance, plan name, and cap.",
      "action_type": "read",
      "chain_callable": false,
      "effects": [],
      "params_schema": {
        "description": "No parameters needed.",
