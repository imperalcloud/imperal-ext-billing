        "title": "EmptyParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "",
      "scopes": [],
      "owner_chat_tool": "tool_billing_chat"
    },
    {
      "name": "get_plan",
      "description": "Get subscription details: plan, status, billing period.",
      "action_type": "read",
      "chain_callable": false,
      "effects": [],
      "params_schema": {
        "description": "No parameters needed.",
        "properties": {},
        "title": "EmptyParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "",
      "scopes": [],
      "owner_chat_tool": "tool_billing_chat"
    },
    {
      "name": "spending_report",
      "description": "Show usage and spending breakdown by meter.",
      "action_type": "read",
      "chain_callable": false,
      "effects": [],
      "params_schema": {
        "description": "No parameters needed.",
